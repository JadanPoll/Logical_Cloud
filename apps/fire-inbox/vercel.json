{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/*.js": {"maxDuration": 300},
    "api/messages/*.js": {"maxDuration": 300}
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{"key":"Cache-Control","value":"no-store"}]
    }
  ]
}
